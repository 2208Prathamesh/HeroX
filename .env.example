# HeroX AI Bot Environment Variables
# Copy this file to .env and fill in your values

# ── Discord (Required) ────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id
GUILD_ID=your_test_guild_id_for_dev

# ── Encryption (Required) ─────────────────────────────────────────
# Change this to any random long string (used to encrypt user API keys)
ENCRYPTION_SECRET=herox-super-secret-change-this-now-2025!

# ── Global Free AI (Optional but Recommended) ─────────────────────
# Put your OpenRouter key here. If a user doesn't set their own key,
# the bot will fallback to using this key with a FREE model (Gemma 2 9B).
GLOBAL_FREE_API_KEY=

# ── Optional: Video Generation ────────────────────────────────────
# Get from https://app.runwayml.com/
RUNWAY_API_KEY=
